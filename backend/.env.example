PORT=5000
MONGODB_URI=mongodb://localhost:27017/shopease
JWT_SECRET=change_me_dev_only
CORS_ORIGIN=http://localhost:5173

# Login rate limiting (FR-033). Window length in ms (default 15 minutes) and max failed attempts.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
# Set to true (or a hop count / subnet) when behind a proxy so X-Forwarded-For is used as the client IP.
TRUST_PROXY=false
# General API rate limit (requests per 15 minutes per IP). Ignored when NODE_ENV=test.
GLOBAL_RATE_LIMIT_MAX=1000

# Seed credentials (optional overrides)
# SEED_ADMIN_EMAIL=admin@shopease.com
# SEED_ADMIN_PASSWORD=Admin@123
# SEED_CUSTOMER1_EMAIL=asha@example.com
# SEED_CUSTOMER2_EMAIL=ravi@example.com
# SEED_CUSTOMER_PASSWORD=Shop1234

# Email verification (ONC-001). Leave empty for local dev: emails are then only logged, not sent.
# When NODE_ENV=test no email is ever sent; messages are captured in memory (GET /api/test/emails).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Public URL of the frontend, used in the verification link (falls back to http://localhost:5173 when empty).
APP_URL=
